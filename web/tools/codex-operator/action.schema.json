{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "rationale": { "type": "string", "minLength": 1, "maxLength": 500 },
    "action": {
      "type": "string",
      "enum": ["hold_key", "drag_camera", "tap", "wait", "finish"]
    },
    "key": {
      "type": ["string", "null"],
      "enum": ["KeyW", "KeyA", "KeyS", "KeyD", null]
    },
    "durationMs": { "type": ["integer", "null"], "minimum": 100, "maximum": 4000 },
    "startX": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "startY": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "endX": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "endY": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
  },
  "required": [
    "rationale",
    "action",
    "key",
    "durationMs",
    "startX",
    "startY",
    "endX",
    "endY"
  ]
}

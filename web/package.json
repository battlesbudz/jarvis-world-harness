{
  "name": "jarvis-world-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run && node --test tools/codex-operator/*.test.mjs",
    "test:e2e": "playwright test",
    "test:codex-operator": "node tools/codex-operator/run.mjs",
    "verify:codex-operator": "node tools/codex-operator/verify-report.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "9.23.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@openai/codex": "0.151.0",
    "@playwright/test": "1.62.1",
    "@types/node": "24.10.9",
    "eslint": "10.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
